/* N1700 Bridge Stylesheet */

QMainWindow {
    background-color: #f5f5f5;
}

QLabel#verdict-ok {
    background-color: #4caf50;
    color: white;
    font-weight: bold;
    padding: 4px 8px;
    border-radius: 3px;
}

QLabel#verdict-ng {
    background-color: #f44336;
    color: white;
    font-weight: bold;
    padding: 4px 8px;
    border-radius: 3px;
}

QLabel#verdict-pending {
    background-color: #9e9e9e;
    color: white;
    padding: 4px 8px;
    border-radius: 3px;
}

QPushButton {
    padding: 6px 16px;
    border: 1px solid #ccc;
    border-radius: 4px;
    background-color: #ffffff;
}

QPushButton:hover {
    background-color: #e0e0e0;
}

QPushButton#export-btn {
    background-color: #1976d2;
    color: white;
    border: none;
    font-weight: bold;
}

QPushButton#export-btn:hover {
    background-color: #1565c0;
}

QPushButton#save-btn {
    background-color: #388e3c;
    color: white;
    border: none;
}

QLineEdit {
    padding: 4px 8px;
    border: 1px solid #bdbdbd;
    border-radius: 3px;
}

QLineEdit:read-only {
    background-color: #eeeeee;
}

QTableWidget {
    gridline-color: #e0e0e0;
    border: 1px solid #bdbdbd;
}

QTableWidget::item {
    padding: 4px;
}

QStatusBar {
    background-color: #e0e0e0;
}

QFrame#warning-banner {
    background-color: #B71C1C;
    border-radius: 4px;
    padding: 4px;
    margin: 2px 0;
}

QLabel#warning-text {
    color: white;
    font-weight: bold;
    font-size: 12px;
}

QPushButton#warning-close {
    color: white;
    background: transparent;
    border: none;
    font-weight: bold;
}

QPushButton#warning-close:hover {
    color: #FFCDD2;
}
